<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- "required" -> Play Store will refuse to list this app for devices
         without ARCore support, and ARCoreApk.checkAvailability() below can
         rely on ARCore already being expected to work here. -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="true" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.PhoneTracker"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: this app POSTs plain http:// to the
             viewer's own LAN server (see PoseSender.kt / arcore_ingest.php),
             which Android blocks by default since API 28. This is a
             native app's own networking, not a browser page, so it isn't
             subject to the browser secure-context restriction that forced
             this whole project onto phyphox in the first place. -->

        <meta-data android:name="com.google.ar.core" android:value="required" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
